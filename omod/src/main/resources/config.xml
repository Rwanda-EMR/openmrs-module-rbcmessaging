<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.rbcmessaging</package>
	<author>MoH and PIH/IMB</author>
	<description>
		${project.parent.description}
	</description>
	<!-- <updateURL>https://modules.openmrs.org/modules/download/${project.parent.artifactId}/update.rdf</updateURL> -->
	<require_version>${openmrsPlatformVersion}</require_version>
	<!-- / Module Properties -->

	<require_modules>
		<require_module version="${htmlformentryVersion}">org.openmrs.module.htmlformentry</require_module>
		<require_module version="${uiframeworkVersion}">org.openmrs.module.uiframework</require_module>
		<require_module version="${appuiVersion}">org.openmrs.module.appui</require_module>
	</require_modules>

	<!-- Module Activator -->
	<activator>org.openmrs.module.rbcmessaging.RBCMessagingModuleActivator	</activator>


	<!-- Extensions -->
	<extension>
		<point>org.openmrs.admin.list</point>
		<class>org.openmrs.module.rbcmessaging.extension.html.AdminList</class>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>

	<!-- Maps hibernate file's, if present -->
	<mappingFiles>

		RBCMessagingMessage.hbm.xml

	</mappingFiles>
	
		<globalProperty>
		<property>rbcmessaging.messagingConfig</property>
		<defaultValue></defaultValue>
		<description>
			A JSON configuration showing the number of days before
			sending an SMS reminder for each appointment service and the actual
			message text to send.
		</description>
	</globalProperty>

	<globalProperty>
		<property>rbcmessaging.birthdayWishes</property>
		<defaultValue></defaultValue>
		<description>
			The message to send as birthday wishes.
		</description>
	</globalProperty>
	
	<globalProperty>
		<property>rbcmessaging.postURL</property>
		<defaultValue></defaultValue>
		<description>RapidPro URL to post to</description>
	</globalProperty>

	<globalProperty>
		<property>rbcmessaging.Authorization</property>
		<defaultValue></defaultValue>
		<description>RapidPro API Token</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.gateway</property>
		<defaultValue>fdibiz</defaultValue>
		<description>SMS gateway implementation to use. Supported values are fdibiz and intouch.</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.username</property>
		<defaultValue></defaultValue>
		<description>API UserName</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.password</property>
		<defaultValue></defaultValue>
		<description>API password</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.sender</property>
		<defaultValue></defaultValue>
		<description>SMS sender</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.authorizationURL</property>
		<defaultValue></defaultValue>
		<description>API Authorization URL</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.postURL</property>
		<defaultValue></defaultValue>
		<description>URL to post to</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.appointmentDateConceptUUIDs</property>
		<defaultValue></defaultValue>
		<description>Concept UUID for Appointment Dates with coma separator(,)</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpih.locationId</property>
		<defaultValue></defaultValue>
		<description>Location ID where sms notification has been started as pilot </description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.postURL</property>
		<defaultValue></defaultValue>
		<description>Intouch HTTP API send URL</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.username</property>
		<defaultValue></defaultValue>
		<description>Intouch account username</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.password</property>
		<defaultValue></defaultValue>
		<description>Intouch account password</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.sender</property>
		<defaultValue></defaultValue>
		<description>Intouch alphanumeric SMS sender</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.coding</property>
		<defaultValue>0</defaultValue>
		<description>Intouch message encoding value</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.deliveryReportURL</property>
		<defaultValue></defaultValue>
		<description>Optional callback URL that receives Intouch delivery reports</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.intouch.deliveryReportLevel</property>
		<defaultValue>2</defaultValue>
		<description>Intouch delivery report level: 1, 2, or 3</description>
	</globalProperty>
	
	<globalProperty>
		<property>rbcmessaging.phoneAttribute</property>
		<defaultValue></defaultValue>
		<description>Name of the Person Attribute Type used to record phone contacts for patients during registration</description>
	</globalProperty>
	
	<globalProperty>
		<property>rbcmessaging.countryCode</property>
		<defaultValue></defaultValue>
		<description>Phone Country Code (eg. +251 For EThiopia or +250 For Rwanda)</description>
	</globalProperty>



	<globalProperty>
		<property>rbcmessaging.mohpihncd.username</property>
		<defaultValue></defaultValue>
		<description>API UserName</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpihncd.password</property>
		<defaultValue></defaultValue>
		<description>API password</description>
	</globalProperty>
	<globalProperty>
		<property>rbcmessaging.mohpihncd.contactPhoneNumber</property>
		<defaultValue></defaultValue>
		<description>contact Phone Number to be added at the end of sms </description>
	</globalProperty>



	<!-- Internationalization -->
	<!-- All message codes should start with ${project.parent.artifactId}. -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->

</module>
